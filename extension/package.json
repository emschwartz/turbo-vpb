{
  "name": "turbovpb-extension",
  "version": "1.0.0",
  "type": "module",
  "description": "Turbocharge phone banking with OpenVPB, VAN, and BlueVote. Call and text with 2 clicks!",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt --browser firefox",
    "build": "wxt build",
    "build:firefox": "wxt build --browser firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip --browser firefox",
    "postinstall": "wxt prepare"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emschwartz/turbo-vpb.git"
  },
  "author": "Evan Schwartz <evan@turbovpb.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/emschwartz/turbo-vpb/issues"
  },
  "homepage": "https://github.com/emschwartz/turbo-vpb#readme",
  "devDependencies": {
    "@preact/preset-vite": "^2.5.0",
    "@tailwindcss/vite": "^4.2.2",
    "prettier": "^3.0.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.1.6",
    "wxt": "^0.20.20"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.17",
    "@heroicons/react": "^2.0.18",
    "@preact/signals": "^1.2.1",
    "preact": "^10.17.0",
    "react-qr-code": "^2.0.12",
    "reconnecting-websocket": "^4.4.0",
    "tingle.js": "^0.16.0"
  }
}
