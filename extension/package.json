{
  "name": "turbovpb-extension",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.4.0",
  "description": "Turbocharge phone banking with OpenVPB, VAN, and BlueVote. Call and text with 2 clicks!",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt --browser firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build --browser firefox --mv3",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip --browser firefox --mv3",
    "postinstall": "wxt prepare",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emschwartz/turbo-vpb.git"
  },
  "author": "Evan Schwartz <evan@turbovpb.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/emschwartz/turbo-vpb/issues"
  },
  "homepage": "https://github.com/emschwartz/turbo-vpb#readme",
  "devDependencies": {
    "@preact/preset-vite": "^2.10.5",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/preact": "^3.2.4",
    "jsdom": "^29.0.1",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2",
    "wxt": "^0.20.20"
  },
  "dependencies": {
    "@preact/signals": "^2.9.0",
    "preact": "^10.29.0",
    "qrcode-generator": "^2.0.4",
    "reconnecting-websocket": "^4.4.0"
  }
}
